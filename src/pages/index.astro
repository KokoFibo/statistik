---
import Layout from '../layouts/Layout.astro';
import { laporan, kelompok } from '../data/laporan';
const nav = kelompok.map((k) => [k.id, k.judul] as [string, string]);
---
<Layout title="Ringkasan Laporan Statistik BPS dan APJII" description="Ringkasan dan analisis publikasi BPS dan survei APJII, satu laporan per halaman: ekonomi, pekerja, pendidikan, desa, dan internet." nav={nav} home>
<header class="hero"><div class="wrap" style="padding-bottom:64px">
  <h1>Laporan statistik, diringkas</h1>
  <p class="lead">Ringkasan dan analisis publikasi BPS dan survei APJII, satu laporan per halaman. Pilih topik di bawah.</p>
</div></header>

{kelompok.map((k, i) => (
  <section class={`s${i % 2 ? ' alt' : ''}`} id={k.id}><div class="wrap grid">
    <header><h2>{k.judul}</h2><p>{k.ket}</p></header>
    <ul class="hub">
      {laporan.filter((l) => l.kelompok === k.id).map((l) => (
        <li>
          <div class="ht"><a class="hl" href={`/${l.slug}`}>{l.judul}</a>{l.sumber !== 'BPS' && <span class="tag">{l.sumber}</span>}</div>
          <p>{l.ket}</p>
          <div class="fig"><b>{l.angka}</b><small>{l.angkaKet}</small></div>
        </li>
      ))}
    </ul>
  </div></section>
))}

<footer slot="footer"><div class="wrap">Sumber: Badan Pusat Statistik (BPS) dan Asosiasi Penyelenggara Jasa Internet Indonesia (APJII). Ringkasan disusun dari PDF publikasi; periksa ke <a href="https://www.bps.go.id">bps.go.id</a> untuk kutipan resmi.</div></footer>
</Layout>
